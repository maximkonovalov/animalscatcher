# Local configuration (contains RTSP/Telegram credentials)
ac.cfg

# Logs
*.log
logs/

# PID file (written at startup so an external tool, e.g. newsyslog, can
# signal this process to reopen its log files after rotating them)
*.pid

# Snapshots / detection output
snaps/

# AI model weight caches (downloaded on first run)
*.pt
*.pth
checkpoints/

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store
