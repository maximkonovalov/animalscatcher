[CAMERA]
user = <username>
pass = <password>
ip = 192.168.xx.xx
port = 8554

[TELEGRAM]
token = <token>
chat_id = <-100..>

[DETECTION]
# Animal, Person, Vehicle
threshold_0 = 0.45
threshold_1 = 0.75
threshold_2 = 0.95
cooldown = 20
frame_interval = 10
# Summary interval in hours (e.g., 6)
summary_interval = 6
# Minimum confidence to accept a species classification (Stage 2)
species_threshold = 0.45
# Tolerance for "Static" object detection, as a fraction of frame
# width/height (e.g., 0.03 = approx 3%)
static_tolerance = 0.03
# Species classifier (Stage 2): "dfne" (default, requirements.txt only
# -- northeastern US species) or "speciesnet" (requires also installing
# requirements-speciesnet.txt -- 2498 taxa, better suited to regions
# DFNE doesn't cover, e.g. no puma/mountain lion at all, mule deer vs.
# DFNE's white-tailed deer only). See README's Species Classifier
# section.
# classifier = dfne
# Only used when classifier = speciesnet. A kaggle: model identifier
# (auto-downloaded on first use, no Kaggle account needed for Google's
# public model) or a local directory with a pre-downloaded copy.
# Defaults to Google's own recommended model if left unset.
# speciesnet_model = kaggle:google/speciesnet/pyTorch/v4.0.3a/1
# Extra margin added around a detection box before cropping for species
# classification, as a fraction of the box's own width/height (e.g.,
# 0.15 = 15% larger on each side). A tight box can clip a tail, ear, or
# antler the classifier needs.
# crop_padding = 0.15

[PATHS]
base_output_folder = /home/ac/snaps

[CLEANUP]
# Number of days to keep snapshots
max_age_days = 7
# How often to check for old files (in hours)
cleanup_interval = 24

# EOF
