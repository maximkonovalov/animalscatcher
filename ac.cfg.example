[CAMERA]
user = <username>
pass = <password>
ip = 192.168.xx.xx
port = 8554

[TELEGRAM]
token = <token>
chat_id = <-100..>

[DETECTION]
# Animal, Person, Vehicle
threshold_0 = 0.45
threshold_1 = 0.75
threshold_2 = 0.95
cooldown = 20
frame_interval = 10
# Summary interval in hours (e.g., 6)
summary_interval = 6
# Minimum confidence to accept a species classification (Stage 2)
species_threshold = 0.45
# Tolerance for "Static" object detection, as a fraction of frame
# width/height (e.g., 0.03 = approx 3%)
static_tolerance = 0.03

[PATHS]
base_output_folder = /home/ac/snaps

[CLEANUP]
# Number of days to keep snapshots
max_age_days = 7
# How often to check for old files (in hours)
cleanup_interval = 24

# EOF
