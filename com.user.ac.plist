<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.ac</string>
    <!-- No UserName (runs as root), TEMPORARY, revisit. Dropping
         privileges to maxim via UserName still breaks this daemon's
         outbound connectivity even after ad-hoc code-signing
         /opt/local/bin/python3.10 (deploy.sh does this on every deploy
         regardless, since it's a real prerequisite either way). Signing
         fixed one confirmed cause (an unsigned interpreter dropped to a
         session-less, non-root UID) but evidently isn't sufficient by
         itself, so root is the known-working interim state while this
         gets debugged further. See RELEASES.md v0.8 for the full
         investigation so far. -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/local/bin/python3.10</string>
        <string>/Users/maxim/nvr/ac.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>WorkingDirectory</key>
    <string>/Users/maxim/nvr/</string>
    <key>StandardOutPath</key>
    <string>/Users/maxim/nvr/logs/ac_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/maxim/nvr/logs/ac_error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/maxim</string>
    </dict>
</dict>
</plist>
