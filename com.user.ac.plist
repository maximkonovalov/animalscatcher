<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.ac</string>
    <!-- No UserName (runs as root): a UserName-based privilege drop to
         maxim blocks this daemon's outbound LAN connections entirely,
         confirmed by direct testing (root works, UserName: maxim does
         not, for the identical connection). Root and unprivileged
         interactive sessions as maxim are both unaffected; only a
         background daemon dropped to that specific UID is blocked, by
         some mechanism that isn't TCC, pf, a System Extension, or a
         configuration profile (all checked and ruled out). -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/local/bin/python3.10</string>
        <string>/Users/maxim/nvr/ac.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>WorkingDirectory</key>
    <string>/Users/maxim/nvr/</string>
    <key>StandardOutPath</key>
    <string>/Users/maxim/nvr/logs/ac_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/maxim/nvr/logs/ac_error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/maxim</string>
    </dict>
</dict>
</plist>
