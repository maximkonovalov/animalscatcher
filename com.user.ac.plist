<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.ac</string>
    <!-- UserName maxim: retrying the privilege drop. A standalone
         debug/rtsp_probe.py comparison (root vs maxim, same signed
         python3.10, real camera URL) came back identical for both
         identities: TCP connect and RTSP frame read both succeeded
         under maxim, unlike the earlier "No route to host" symptom.
         Revert to no UserName (runs as root) if this recurs, which
         happened once already after an earlier signing fix that also
         looked clean at first, for reasons still not fully understood.
         See RELEASES.md v0.8/v0.9 for the full investigation so far. -->
    <key>UserName</key>
    <string>maxim</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/local/bin/python3.10</string>
        <string>/Users/maxim/nvr/ac.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>WorkingDirectory</key>
    <string>/Users/maxim/nvr/</string>
    <key>StandardOutPath</key>
    <string>/Users/maxim/nvr/logs/ac_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/maxim/nvr/logs/ac_error.log</string>
    <!-- AC_STDOUT_LOG/AC_STDERR_LOG must be kept identical to
         StandardOutPath/StandardErrorPath above: ac.py's SIGUSR1
         handler reopens those two exact paths after an external log
         rotation (see newsyslog.d/animalscatcher.conf), since it has
         no other way to know what launchd redirected its stdout/stderr
         to. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/maxim</string>
        <key>AC_STDOUT_LOG</key>
        <string>/Users/maxim/nvr/logs/ac_stdout.log</string>
        <key>AC_STDERR_LOG</key>
        <string>/Users/maxim/nvr/logs/ac_error.log</string>
    </dict>
</dict>
</plist>
