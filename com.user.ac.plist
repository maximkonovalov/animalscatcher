<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.ac</string>
    <!-- UserName requires /opt/local/bin/python3.10 to be code-signed
         (even just ad-hoc: sudo codesign -f -s - /opt/local/bin/python3.10,
         same as deploy.sh does on every deploy). A completely unsigned
         interpreter running as this LaunchDaemon's dropped-privilege UID
         (no root, no attached login session) gets its outbound network
         silently blocked by macOS. Root and real interactive sessions
         (SSH, sudo -u, screen sharing) are both unaffected regardless of
         signature, which is what made this so confusing to isolate. -->
    <key>UserName</key>
    <string>maxim</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/local/bin/python3.10</string>
        <string>/Users/maxim/nvr/ac.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>WorkingDirectory</key>
    <string>/Users/maxim/nvr/</string>
    <key>StandardOutPath</key>
    <string>/Users/maxim/nvr/logs/ac_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/maxim/nvr/logs/ac_error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/maxim</string>
    </dict>
</dict>
</plist>
