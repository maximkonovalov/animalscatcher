<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.debug.rtsp_probe_root</string>
    <!-- Throwaway diagnostic, not part of the daemon: runs rtsp_probe.py
         as root once at load, for comparison against the UserName-maxim
         variant of this same plist. Safe to bootout and delete once the
         UserName investigation concludes. -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/local/bin/python3.10</string>
        <string>/Users/maxim/nvr/debug/rtsp_probe.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/maxim/nvr</string>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/maxim/nvr/logs/rtsp_probe_root.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/maxim/nvr/logs/rtsp_probe_root.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/maxim</string>
    </dict>
</dict>
</plist>
